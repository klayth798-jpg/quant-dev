QUANTDEV_ENV=development
QUANTDEV_DATA_MODE=demo
QUANTDEV_DATABASE_PATH=./data/quantdev.db
QUANTDEV_LOG_LEVEL=INFO

# Optional market data adapters
MARKET_DATA_SDK=tushare
TUSHARE_TOKEN=
TINYSHARE_TOKEN=
TUSHARE_FINANCIAL_VIP=false
TUSHARE_CALL_INTERVAL_SECONDS=0.35
TUSHARE_DEFAULT_INDICES=000300.SH,000905.SH,000852.SH

# Optional read-only connection to deep-research-quant
DEEP_RESEARCH_BASE_URL=
DEEP_RESEARCH_API_KEY=

# Reserved for future paper/live broker adapters
BROKER_PROVIDER=paper
BROKER_ACCOUNT_ID=
BROKER_API_KEY=
BROKER_API_SECRET=
