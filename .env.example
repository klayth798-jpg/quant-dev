QUANTDEV_ENV=development
QUANTDEV_DATA_MODE=demo
QUANTDEV_DATABASE_PATH=./data/quantdev.db
QUANTDEV_DATABASE_BACKEND=sqlite
QUANTDEV_DATABASE_URL=
QUANTDEV_TASK_BACKEND=inline
QUANTDEV_REDIS_URL=redis://127.0.0.1:6379/0
QUANTDEV_TASK_QUEUE_NAME=quantdev:tasks
QUANTDEV_TASK_MAX_ATTEMPTS=3
QUANTDEV_TASK_VISIBILITY_TIMEOUT_SECONDS=1800
QUANTDEV_WORKER_POLL_SECONDS=5
QUANTDEV_LOG_LEVEL=INFO

# Optional market data adapters
MARKET_DATA_SDK=tushare
TUSHARE_TOKEN=
TINYSHARE_TOKEN=
TUSHARE_FINANCIAL_VIP=false
TUSHARE_CALL_INTERVAL_SECONDS=0.35
TUSHARE_DEFAULT_INDICES=000300.SH,000905.SH,000852.SH

# Optional read-only connection to deep-research-quant
DEEP_RESEARCH_BASE_URL=
DEEP_RESEARCH_API_KEY=

# Paper/live execution safety
QUANTDEV_BROKER_MODE=disabled
QUANTDEV_BROKER_ADAPTER=
QUANTDEV_LIVE_TRADING_ENABLED=false
QUANTDEV_REQUIRE_ORDER_APPROVAL=true
QUANTDEV_MAX_LIVE_ORDER_NOTIONAL=5000
QUANTDEV_MAX_DAILY_LOSS=1000
QUANTDEV_PAPER_ENFORCE_SESSION=true
QUANTDEV_PAPER_QUOTE_MODE=realtime
QUANTDEV_QUOTE_MAX_AGE_SECONDS=15
QUANTDEV_CALENDAR_FAIL_CLOSED=true
QUANTDEV_AUTO_KILL_ON_RECON_BREAK=true
QUANTDEV_RUNNER_POLL_SECONDS=5
QUANTDEV_RUNNER_LEASE_SECONDS=60
QUANTDEV_APPROVAL_TTL_SECONDS=300
QUANTDEV_RECONCILIATION_MAX_AGE_MINUTES=1440
QUANTDEV_QUOTE_MAX_SPREAD_BPS=100
QUANTDEV_READ_API_KEY=
QUANTDEV_ADMIN_API_KEY=
# 未配置 ADMIN_API_KEY 时写操作默认全部关闭。仅本地开发/测试可显式放行：
QUANTDEV_ALLOW_INSECURE_ADMIN=false
# 每操作员独立密钥，格式 alice:keyA,bob:keyB；配置后审批/提交身份由密钥绑定。
QUANTDEV_OPERATOR_KEYS=
# 双人复核：审批人不能同时提交实盘订单（需另一操作员提交）。实盘强烈建议保持 true。
QUANTDEV_REQUIRE_DUAL_APPROVAL=true
# 企业微信群机器人 webhook：Kill Switch / 对账 BREAK / UNKNOWN 订单等关键事件主动告警。
QUANTDEV_ALERT_WEBHOOK_URL=
# live runner 自动对账间隔（秒）。
QUANTDEV_RECONCILIATION_INTERVAL_SECONDS=300
QUANTDEV_RECONCILIATION_CASH_TOLERANCE_CENTS=0
# Caddy 第一道闸 IP allowlist（空格分隔 CIDR）。默认仅本机+内网，公网需显式加白。
QUANTDEV_ALLOWED_IPS=127.0.0.1/32 ::1 private_ranges

# Real broker credentials are adapter-specific and must never be committed
QUANTDEV_BROKER_DRY_RUN=true
BROKER_ACCOUNT_ID=
BROKER_API_KEY=
BROKER_API_SECRET=
